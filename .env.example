# Application Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# If MongoDB is running locally, use mongodb://127.0.0.1:27017/digital_library
# If left empty or cannot connect, system automatically utilizes embedded memory MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/digital_library

# JWT Configuration
JWT_SECRET=supersecret_jwt_key_university_library_2025_secure
JWT_EXPIRES_IN=1d

# Library Defaults
FINE_DEFAULT_RATE=5
MAX_FINE_AMOUNT=500
HOLD_EXPIRY_DAYS=3
