    {
      "name": "02 Books",
      "item": [
        {
          "name": "Get All Books (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.data && json.data.data.length > 0) {",
                  "  pm.collectionVariables.set('bookId', json.data.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/books?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "books"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{bookId}}"] }
          }
        },
        {
          "name": "Create Book (Librarian/Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{librarianToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud Computing Architecture\",\n  \"author\": \"Thomas Erl\",\n  \"isbn\": \"978-0133387520\",\n  \"category\": \"Networking\",\n  \"description\": \"Comprehensive service-oriented technology and cloud governance.\",\n  \"publisher\": \"Prentice Hall\",\n  \"publicationYear\": 2023,\n  \"totalCopies\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/books", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "Update Book (Librarian/Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{librarianToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated curriculum course text edition.\",\n  \"publisher\": \"University Press\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{bookId}}"] }
          }
        },
        {
          "name": "Delete or Archive Book (Librarian/Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{librarianToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{bookId}}"] }
          }
        }
      ]
    },
    {
      "name": "03 Search",
      "item": [
        {
          "name": "Search by Title",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/books/search?title=database&page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "books", "search"], "query": [{ "key": "title", "value": "database" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
